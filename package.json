{
  "name": "paul-app",
  "version": "1.0.0",
  "description": "A modern TypeScript responsive app",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "ionic:build": "ionic build",
    "ionic:serve": "ionic serve",
    "ionic:cap:add": "ionic capacitor add",
    "ionic:cap:copy": "ionic capacitor copy",
    "ionic:cap:sync": "ionic capacitor sync",
    "ionic:cap:run": "ionic capacitor run",
    "ionic:cap:open": "ionic capacitor open"
  },
  "keywords": [
    "typescript",
    "responsive",
    "modern",
    "app"
  ],
  "author": "Pete",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.10.0",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^8.54.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "@ionic/react": "^8.7.5",
    "@ionic/react-router": "^8.7.5",
    "@supabase/supabase-js": "^2.75.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/dompurify": "^3.2.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@types/validator": "^13.15.3",
    "bcryptjs": "^3.0.2",
    "dompurify": "^3.2.7",
    "ionicons": "^8.0.13",
    "lowdb": "^7.0.1",
    "lucide": "^0.294.0",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "validator": "^13.15.15"
  }
}
